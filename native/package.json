{
  "name": "brp-one-native",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor wrapper for BRP One (Barracks Readiness Program demo app, sample data).",
  "scripts": {
    "copy-web": "node scripts/copy-web.mjs",
    "sync": "npm run copy-web && npx cap sync",
    "icons": "python3 scripts/make-icons.py",
    "patch-ios": "python3 scripts/patch-ios.py",
    "vendor": "python3 scripts/vendor-assets.py",
    "verify-web": "node scripts/verify-web.mjs",
    "verify-mock": "node scripts/verify-bridge-mock.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-app-review": "^8.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  },
  "engines": {
    "node": ">=22"
  }
}
